---
import type { Locale } from '../i18n/translations';
import { locales, getLocalePath, t } from '../i18n/translations';
import NetworkBackground from '../components/NetworkBackground.astro';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  ogImage?: string;
  canonicalPath?: string;
  type?: string;
  /** FAQ entries rendered on this page, used to emit FAQPage structured data. */
  faqItems?: ReadonlyArray<{ q: string; a: string }>;
}

const {
  title,
  locale = 'en',
  ogImage = '/images/og-image.png',
  canonicalPath,
  type = 'website',
  faqItems,
} = Astro.props;

const description = Astro.props.description ?? t(locale).meta.description;

const siteUrl = 'https://mostro.network';
const fontHref = 'https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap';

// Determine current path without locale prefix
const currentPath = Astro.url.pathname;
let basePath = currentPath;
if (locale !== 'en') {
  basePath = currentPath.replace(`/${locale}`, '') || '/';
}
if (!basePath.startsWith('/')) basePath = `/${basePath}`;
if (!basePath.endsWith('/')) basePath = `${basePath}/`;

// Canonical URL. Astro builds directory-style URLs, so every path ends in a
// slash; keeping that here avoids canonical/sitemap mismatches.
const withTrailingSlash = (path: string) => (path.endsWith('/') ? path : `${path}/`);
const canonicalUrl = `${siteUrl}${withTrailingSlash(canonicalPath ?? currentPath)}`;

// Full OG image URL
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

// Locale to Open Graph locale format
const ogLocaleMap: Record<string, string> = {
  en: 'en_US',
  es: 'es_ES',
  fr: 'fr_FR',
  it: 'it_IT',
  pt: 'pt_BR',
};

// JSON-LD structured data, emitted as a single @graph so the entities can
// reference each other instead of repeating themselves.
const organization = {
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: 'Mostro P2P',
  url: `${siteUrl}/`,
  logo: {
    '@type': 'ImageObject',
    url: `${siteUrl}/images/mostro-logo.png`,
  },
  sameAs: [
    'https://github.com/MostroP2P',
    'https://t.me/MostroP2P',
    'https://x.com/MostroP2P',
    'https://primal.net/p/npub1m0str0d7z2ww8rdh20t2n9lx520xjwhaq24p68umqp06wwrwtsnqen40un',
  ],
};

const website = {
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  name: 'Mostro',
  url: `${siteUrl}/`,
  description: 'Non-custodial peer-to-peer Bitcoin exchange protocol built on Lightning Network and Nostr.',
  inLanguage: [...locales],
  publisher: { '@id': `${siteUrl}/#organization` },
};

const softwareApplication = {
  '@type': 'SoftwareApplication',
  '@id': `${siteUrl}/#software`,
  name: 'Mostro',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Android, iOS, Linux, macOS, Windows',
  url: `${siteUrl}/`,
  description: 'Open protocol to buy and sell Bitcoin peer-to-peer over Lightning Network and Nostr, without KYC or custody of user funds.',
  license: 'https://github.com/MostroP2P/mostro/blob/main/LICENSE',
  isAccessibleForFree: true,
  author: { '@id': `${siteUrl}/#organization` },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};

// Strip the lightweight markdown used in the FAQ copy so the structured data
// carries plain text, as Google requires.
const toPlainText = (value: string) =>
  value.replace(/\*\*(.*?)\*\*/g, '$1').replace(/\s*\n+\s*/g, ' ').trim();

const faqPage = faqItems?.length
  ? {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
          inLanguage: locale,
      mainEntity: faqItems.map(item => ({
        '@type': 'Question',
        name: toPlainText(item.q),
        acceptedAnswer: {
          '@type': 'Answer',
          text: toPlainText(item.a),
        },
      })),
    }
  : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [organization, website, softwareApplication, faqPage].filter(Boolean),
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="Bitcoin, P2P, peer-to-peer, exchange, Lightning Network, Nostr, non-custodial, KYC-free, decentralized, trading, buy Bitcoin, sell Bitcoin, open protocol, censorship resistant" />
    <meta name="author" content="Mostro P2P" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="theme-color" content="#8CC63F" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang alternate links for SEO -->
    {locales.map(l => (
      <link
        rel="alternate"
        hreflang={l}
        href={`${siteUrl}${getLocalePath(l, basePath)}`}
      />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${basePath}`} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mostro — Non-custodial P2P Bitcoin exchange on Lightning Network and Nostr" />
    <meta property="og:site_name" content="Mostro" />
    <meta property="og:locale" content={ogLocaleMap[locale] || locale} />
    {locales.filter(l => l !== locale).map(l => (
      <meta property="og:locale:alternate" content={ogLocaleMap[l] || l} />
    ))}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:site" content="@MostroP2P" />

    <!-- Favicons. Google needs a square icon to show the site favicon in
         search results, hence the dedicated square renders. -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/images/icon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/icon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Fonts. Loaded asynchronously so the webfont request never blocks the
         first render; `display=swap` keeps text visible meanwhile. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={fontHref} />
    <link rel="stylesheet" href={fontHref} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={fontHref} /></noscript>
  </head>
  <body>
    <div class="starfield"></div>
    <NetworkBackground />
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>