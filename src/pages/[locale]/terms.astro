---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TermsContent from '../../components/TermsContent.astro';
import { locales, type Locale } from '../../i18n/translations';

export function getStaticPaths() {
  // Generate paths for non-English locales only
  // English is handled by /terms.astro at root
  return locales
    .filter(locale => locale !== 'en')
    .map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const titles: Record<Locale, string> = {
  en: "Terms of Service — Mostro",
  es: "Términos de Servicio — Mostro",
  it: "Termini di Servizio — Mostro",
  pt: "Termos de Serviço — Mostro",
  fr: "Conditions d'utilisation — Mostro",
};
const title = titles[locale];
---

<Layout {title} {locale}>
  <Header {locale} />
  <main>
    <TermsContent {locale} />
  </main>
  <Footer {locale} />
</Layout>
