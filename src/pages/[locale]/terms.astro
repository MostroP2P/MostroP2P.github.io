---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TermsContent from '../../components/TermsContent.astro';
import { locales, t, type Locale } from '../../i18n/translations';

export function getStaticPaths() {
  // Generate paths for non-English locales only
  // English is handled by /terms.astro at root
  return locales
    .filter(locale => locale !== 'en')
    .map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };

const i = t(locale);
const title = i.meta.termsTitle;
const description = i.meta.termsDescription;
---

<Layout {title} {description} {locale} type="article">
  <Header {locale} />
  <main>
    <TermsContent {locale} />
  </main>
  <Footer {locale} />
</Layout>
