---
import { type Locale, t } from '../i18n/translations';

interface Props { 
  locale: Locale; 
}
const { locale } = Astro.props;
const i = t(locale);
---

<section id="donate" class="section">
  <div class="container">
    <div class="donate-content">
      <h2 class="section-title">{i.donate.title}</h2>
      
      <div class="donate-card glass">
        <div class="donate-icon">⚡</div>
        <p class="donate-text">{i.donate.content}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .donate-content {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
  }

  .donate-card {
    padding: 48px 32px;
    text-align: center;
  }

  .donate-icon {
    font-size: 4rem;
    margin-bottom: 24px;
    display: block;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.05);
    }
  }

  .donate-text {
    color: var(--text-secondary);
    font-size: 1.1rem;
    line-height: 1.8;
  }

  /* Mobile styles */
  @media (max-width: 768px) {
    .donate-card {
      padding: 36px 24px;
    }

    .donate-icon {
      font-size: 3rem;
    }

    .donate-text {
      font-size: 1rem;
    }
  }
</style>