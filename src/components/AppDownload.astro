---
// Download links for the Mostro app. Zapstore is the primary channel and uses
// Zapstore's official badge, unmodified (zapstore/zapstore, assets/images).
// Every platform pill opens the latest GitHub release, which carries the
// Android APKs and the desktop builds.
import { type Locale, t } from '../i18n/translations';
import { APP_RELEASES_URL, ZAPSTORE_URL } from '../config/app';

interface Props {
  locale: Locale;
  // `hero` is centred under the hero buttons; `panel` sits left-aligned
  // inside the Get Started card.
  variant?: 'hero' | 'panel';
}

const { locale, variant = 'hero' } = Astro.props;
const d = t(locale).download;
// The hero badge is above the fold; the panel one is near the bottom.
const loading = variant === 'hero' ? 'eager' : 'lazy';
---

<div class:list={['app-download', `app-download--${variant}`]}>
  <a class="zapstore" href={ZAPSTORE_URL} target="_blank" rel="noopener">
    <img
      src="/images/zapstore-badge.png"
      alt={d.zapstoreAlt}
      width="512"
      height="157"
      loading={loading}
      decoding="async"
    />
  </a>

  <span class="label">{d.githubLabel}</span>
  <div class="platforms">
    <a href={APP_RELEASES_URL} target="_blank" rel="noopener" title={d.hint}>
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="currentColor"
          d="M18.4395 5.5586c-.675 1.1664-1.352 2.3318-2.0274 3.498-.0366-.0155-.0742-.0286-.1113-.043-1.8249-.6957-3.484-.8-4.42-.787-1.8551.0185-3.3544.4643-4.2597.8203-.084-.1494-1.7526-3.021-2.0215-3.4864a1.1451 1.1451 0 0 0-.1406-.1914c-.3312-.364-.9054-.4859-1.379-.203-.475.282-.7136.9361-.3886 1.5019 1.9466 3.3696-.0966-.2158 1.9473 3.3593.0172.031-.4946.2642-1.3926 1.0177C2.8987 12.176.452 14.772 0 18.9902h24c-.119-1.1108-.3686-2.099-.7461-3.0683-.7438-1.9118-1.8435-3.2928-2.7402-4.1836a12.1048 12.1048 0 0 0-2.1309-1.6875c.6594-1.122 1.312-2.2559 1.9649-3.3848.2077-.3615.1886-.7956-.0079-1.1191a1.1001 1.1001 0 0 0-.8515-.5332c-.5225-.0536-.9392.3128-1.0488.5449zm-.0391 8.461c.3944.5926.324 1.3306-.1563 1.6503-.4799.3197-1.188.0985-1.582-.4941-.3944-.5927-.324-1.3307.1563-1.6504.4727-.315 1.1812-.1086 1.582.4941zM7.207 13.5273c.4803.3197.5506 1.0577.1563 1.6504-.394.5926-1.1038.8138-1.584.4941-.48-.3197-.5503-1.0577-.1563-1.6504.4008-.6021 1.1087-.8106 1.584-.4941z"
        ></path>
      </svg>
      Android
    </a>
    <a href={APP_RELEASES_URL} target="_blank" rel="noopener" title={d.hint}>
      <svg width="16" height="16" viewBox="0 0 23 23" aria-hidden="true">
        <path d="M0 2.6 9.5 1.3V11H0z" fill="currentColor"></path>
        <path d="M10.7 1.15 23 0v10.9H10.7z" fill="currentColor"></path>
        <path d="M0 12.1h9.5v9.7L0 20.5z" fill="currentColor"></path>
        <path d="M10.7 12.1H23V23l-12.3-1.6z" fill="currentColor"></path>
      </svg>
      Windows
    </a>
    <a href={APP_RELEASES_URL} target="_blank" rel="noopener" title={d.hint}>
      <svg width="16" height="16" viewBox="0 0 814 1000" aria-hidden="true">
        <path
          fill="currentColor"
          d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"
        ></path>
      </svg>
      macOS
    </a>
    <a href={APP_RELEASES_URL} target="_blank" rel="noopener" title={d.hint}>
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
        <ellipse cx="8.6" cy="21.4" rx="2.6" ry="1.3" fill="#F5B800"></ellipse>
        <ellipse cx="15.4" cy="21.4" rx="2.6" ry="1.3" fill="#F5B800"></ellipse>
        <ellipse cx="12" cy="14.4" rx="6.3" ry="7.1" fill="currentColor"></ellipse>
        <circle cx="12" cy="6.4" r="4.3" fill="currentColor"></circle>
        <ellipse cx="12" cy="15.6" rx="4" ry="5.4" fill="#fff" opacity="0.92"></ellipse>
        <circle cx="10.4" cy="5.9" r="1.5" fill="#fff"></circle>
        <circle cx="13.6" cy="5.9" r="1.5" fill="#fff"></circle>
        <circle cx="10.5" cy="6.1" r="0.75" fill="#111"></circle>
        <circle cx="13.5" cy="6.1" r="0.75" fill="#111"></circle>
        <ellipse cx="12" cy="8.4" rx="1.9" ry="1.3" fill="#F5B800"></ellipse>
      </svg>
      Linux
    </a>
  </div>
</div>

<style>
  .app-download {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .app-download--hero {
    align-items: center;
    margin-bottom: 48px;
  }

  .app-download--panel {
    align-items: flex-start;
  }

  .zapstore {
    display: inline-flex;
    border-radius: 12px;
    transition: transform 0.15s ease;
  }

  .zapstore:hover {
    transform: translateY(-2px);
  }

  .zapstore img {
    display: block;
    width: auto;
    height: 56px;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .platforms {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .app-download--hero .platforms {
    justify-content: center;
  }

  .platforms a {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 9px 16px;
    transition:
      transform 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .platforms a:hover {
    transform: translateY(-1px);
    border-color: var(--accent);
    color: var(--accent);
  }

  .platforms a:focus-visible,
  .zapstore:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (max-width: 768px) {
    .app-download--hero {
      margin-bottom: 36px;
    }

    .zapstore img {
      height: 52px;
    }

    .app-download--panel {
      align-items: center;
    }

    .app-download--panel .platforms {
      justify-content: center;
    }
  }
</style>
